{
  "id": "com.opencode.designbridge",
  "name": "OpenCode Design Bridge",
  "version": "1.0.6",
  "description": "Private local bridge between OpenCode and Adobe XD. Connects to the local Design Bridge service on 127.0.0.1 and executes validated document operations. Not for distribution.",
  "main": "index.html",
  "manifestVersion": 4,
  "host": {
    "app": "XD",
    "minVersion": "36.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "bridge.panel",
      "label": "OpenCode Design Bridge"
    }
  ],
  "icons": [
    {
      "width": 24,
      "height": 24,
      "path": "icons/icon.png",
      "scale": [1, 2],
      "theme": ["all"],
      "species": ["pluginList"]
    },
    {
      "width": 48,
      "height": 48,
      "path": "icons/icon-lg.png",
      "scale": [1, 2],
      "theme": ["all"],
      "species": ["pluginList"]
    }
  ]
}
